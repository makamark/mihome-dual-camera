#!/usr/bin/expect -f
set timeout 120
log_user 0
set src [lindex $argv 0]
set dst [lindex $argv 1]
spawn scp -r -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ainice@192.0.2.142:$src $dst
expect {
  "assword:" { send "REDACTED\r" }
  timeout { puts "TIMEOUT"; exit 1 }
}
expect {
  eof {}
  timeout { puts "TIMEOUT"; exit 1 }
}
puts "SCP_DONE"
