#!/usr/bin/expect -f
set timeout [expr {60 + 30}]
log_user 1
set cmd [lindex $argv 0]
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null ainice@192.0.2.142 $cmd
expect {
  "assword:" { send "REDACTED\r" }
  timeout { puts "CONNECT_TIMEOUT"; exit 1 }
}
expect {
  eof {}
  timeout { puts "CMD_TIMEOUT"; exit 1 }
}
